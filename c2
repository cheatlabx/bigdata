from pyspark.sql import SparkSession
from pyspark.sql.functions import col

# Create Spark session
spark = SparkSession.builder.appName("RetailAnalysis").getOrCreate()

# Reduce log messages
spark.sparkContext.setLogLevel("ERROR")

# Read CSV file
df = spark.read.csv(
    "sales_data.csv",
    header=True,
    inferSchema=True
)

# Select required columns and rename columns
df_selected = df.select(
    "OrderID",
    "ProdName",
    "Category",
    "Qty",
    "UnitPrice"
)

df_renamed = df_selected.withColumnRenamed(
    "ProdName", "Product_Name"
).withColumnRenamed(
    "UnitPrice", "Price"
)

# Filter Electronics products with price > 100
df_filtered = df_renamed.filter(
    (col("Category") == "Electronics") &
    (col("Price") > 100)
)

# Create new column Total_Amount
df_total = df_filtered.withColumn(
    "Total_Amount",
    col("Qty") * col("Price")
)

# Sort by Total_Amount descending
df_sorted = df_total.orderBy(
    col("Total_Amount").desc()
)

# Show final output
print("Final Retail Sales Data")
df_sorted.show()

# Stop Spark session
spark.stop()
